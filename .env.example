# Backend API root (axios baseURL).
# If you want requests to show as `http://16.170.235.75/...` in DevTools,
# use an absolute URL (no Vite proxy).
VITE_API_BASE_URL=http://16.170.235.75

# Per-request timeout in milliseconds.
VITE_API_TIMEOUT=30000

# Google OAuth client id for @react-oauth/google
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

