
VITE_API_BASE_URL=http://localhost:8000/api

VITE_API_TIMEOUT=30000

# ---------------- Google OAuth (frontend) ----------------

VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# ---------------- GitHub OAuth (frontend) ----------------
# Fill with your GitHub OAuth App client id. Leave callback URL empty to
# use the Authorization callback URL registered at GitHub (recommended).
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
# Optional: explicit redirect URI to send to GitHub. Prefer leaving empty.
# VITE_GITHUB_CALLBACK_URL=
